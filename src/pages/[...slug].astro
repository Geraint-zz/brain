---
import sections from '../data/sections.json';
import categories from '../data/categories.json';
import posts from '../data/posts.json';
export function getStaticPaths() {
  const legalRoutes = ['about','privacy-policy','terms','user-agreement']; const routeList = sections.map((x) => 'section/' + x.slug).concat(categories.map((x) => 'category/' + x.slug), posts.map((x) => 'post/' + x.slug), legalRoutes);
  return routeList.map((route) => ({ params: { slug: route } }));
}
const route = Astro.params.slug ?? '';
const parts = route.split('/');
const kind = parts.length > 1 ? parts[0] : 'legal';
const slug = parts[1] ?? parts[0] ?? '';
const section = sections.find((x) => x.slug === slug);
const category = categories.find((x) => x.slug === slug);
const post = posts.find((x) => x.slug === slug);
const sectionCategories = categories.filter((x) => x.section_slug === slug);
const categoryPosts = posts.filter((x) => x.category_slug === slug);
const categoryLabel = category ? category.slug.replaceAll('-', ' ') : undefined;

const legalPages = {
  about: { title: 'About Brain', description: 'How Brain organizes practical, evidence-informed brain health guidance.', sections: [['What Brain is', 'Brain is an English-language resource for readers who want practical, evidence-informed information about brain health and cognitive training.'], ['What we cover', 'Our coverage includes everyday cognitive health, audience-specific learning and workplace guidance, neutral tools reviews, and research explainers.'], ['How we create content', 'We aim for clear, useful, readable material that distinguishes evidence from opinion and may be updated when scope or important information changes.'], ['Important limitations', 'Brain provides general educational information. It does not provide medical advice, diagnosis, treatment, disease prevention, or emergency guidance. Seek timely help from a qualified professional for serious or urgent symptoms or decisions.'], ['Our reader promise', 'We aim to make complex topics easier to understand, avoid unnecessary jargon, and state important limits.']]},
  'privacy-policy': { title: 'Privacy Policy', description: 'How Brain may handle technical visitor information and future site-service changes.', sections: [['Introduction', 'Brain respects reader privacy. This policy describes information that may be collected when people visit or use the site.'], ['Information we may collect', 'The site may receive basic technical and usage information, such as browser and device type, pages visited, referring pages, approximate location derived from IP address, and timestamps. Do not submit sensitive information through the site.'], ['How information may be used', 'Information may be used to operate and secure the site, improve content and performance, and investigate technical problems or abuse.'], ['Cookies and future services', 'If analytics, advertising, affiliate links, newsletter services, or similar services are added, this policy will be updated to describe them and available choices.'], ['Third-party links and sharing', 'Third-party sites have their own privacy practices. Information may be processed by hosting, security, or other service providers, or disclosed where required by law.'], ['Changes', 'This policy may change when site features, services, or applicable requirements change.']]},
  terms: { title: 'Terms of Use', description: 'Terms governing use of Brain educational, review, and research content.', sections: [['Acceptance and scope', 'By using Brain, you agree to these Terms. Brain provides general educational guides, reviews, research explainers, and related editorial content.'], ['Not professional advice', 'Content is general information, not medical advice, diagnosis, treatment, prevention, or personalized professional guidance. Consult qualified professionals for high-stakes or urgent decisions.'], ['Acceptable use', 'Do not misuse the site, interfere with security, seek unauthorized access, scrape or republish substantial content, overload systems, or use the site for unlawful, harmful, misleading, or abusive purposes.'], ['Intellectual property', 'Site text, organization, design, and branding may be protected by law. You may read and share links for personal, non-commercial use.'], ['No guarantees and liability', 'Content may contain errors, become outdated, or not fit every situation. To the fullest extent permitted by law, Brain is not responsible for loss arising from use of the site, reliance on content, external links, or technical interruptions.'], ['Changes', 'Content, features, and these Terms may change as the site develops.']]},
  'user-agreement': { title: 'User Agreement', description: 'Reader responsibilities for using Brain brain-health and cognitive-training resources.', sections: [['Responsible use', 'By using Brain, you agree to use it lawfully, respectfully, and in line with this User Agreement.'], ['Reader responsibilities', 'Respect intellectual-property rights, avoid abusive automation or interference, verify important information before acting on it, and seek qualified professional help for urgent or high-stakes health decisions.'], ['Content reliance', 'Brain is a general educational and editorial resource. It is not a substitute for clinical assessment or care; sudden or serious changes in memory, thinking, speech, balance, mood, or daily functioning warrant timely professional guidance.'], ['Prohibited uses', 'Do not attack or overload the site, access it without authorization, republish substantial content without permission, distribute unlawful or infringing material, or misrepresent affiliation with Brain.'], ['Third-party resources', 'Review third-party terms, privacy policies, prices, claims, and safety information before using external tools, products, services, or links.'], ['Other policies', 'Read this agreement with the Privacy Policy and Terms of Use.']]}
};
const legal = legalPages[slug as keyof typeof legalPages];
const title = legal?.title ?? section?.name ?? categoryLabel ?? post?.title ?? slug.replaceAll('-', ' ');
const description = legal?.description ?? post?.excerpt ?? 'Evidence-informed Brain content.';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><link rel="canonical" href={new URL(Astro.url.pathname,'https://brain-9do.pages.dev')}><title>{title} | Brain</title><link rel="stylesheet" href="/assets/styles/brain-local.css"></head><body><header><a class="brand-lockup" href="/"><img class="brand-mark" src="/assets/images/brain-logo.png" alt="" aria-hidden="true"><strong>Brain</strong></a><nav><a href="/section/everyday-cognitive-health/">Everyday Cognitive Health</a><a href="/section/audience-programs/">Audience Programs</a><a href="/section/tools-reviews/">Tools &amp; Reviews</a><a href="/section/research-industry/">Research &amp; Industry</a></nav><a href="/about/">About</a></header><main><p class="eyebrow">{kind === 'post' ? 'ARTICLE' : kind === 'category' ? 'CATEGORY' : 'SECTION'}</p><h1>{title}</h1><p class="lead">{description}</p>{kind === 'section' && sectionCategories.length > 0 && <section><h2>Explore this section</h2><div class="cards">{sectionCategories.map((item) => <a class="card" href={'/category/' + item.slug + '/'}><h3>{item.slug.replaceAll('-', ' ')}</h3><p>Browse evidence-informed guidance in this category.</p><span>View category →</span></a>)}</div></section>}{kind === 'category' && categoryPosts.length > 0 && <section><h2>Articles in this category</h2><div class="cards">{categoryPosts.map((item) => <a class="card" href={'/post/' + item.slug + '/'}><p class="eyebrow">{item.published_at.slice(0,10)}</p><h3>{item.title}</h3><p>{item.excerpt}</p><span>Read article →</span></a>)}</div></section>}{kind === 'post' && post && <article class="article-content"><p class="eyebrow">{post.category_slug.replaceAll('-', ' ')}</p><p>Published {post.published_at.slice(0,10)}</p><img src={'/assets/images/' + post.slug + '/featured.png'} alt={post.image_alt}><div set:html={post.body}></div><img src={'/assets/images/' + post.slug + '/closing.png'} alt={post.title + ' closing image'}><p class="disclaimer">{post.disclaimer}</p></article>}{legal && <article class="legal-content">{legal.sections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}</article>}{!legal && kind !== 'post' && kind !== 'category' && kind !== 'section' && <p>Brain provides general educational information. It does not provide medical advice, diagnosis, treatment, or emergency guidance.</p>}</main><footer>General educational information only. <a href="/about/">About</a> · <a href="/privacy-policy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/user-agreement/">User Agreement</a></footer></body></html>
